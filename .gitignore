wandb/
.neptune/

# 系统文件
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak

# IDE
.vscode/
.idea/
*.iml

# Ultralytics 缓存
.ultralytics_cache/

# ============================================
# 关键:所有训练运行结果目录(runs/)全部排除
# 包括但不限于:
# - runs/detect/         (detect 训练)
# - runs/classify/       (classify 训练)
# - runs/segment/        (segment 训练)
# - runs/pose/           (pose 训练)
# - runs/obb/            (obb 训练)
# - runs/f11_teacher_cache/    (F11 冒烟1缓存)
# - runs/f11_q_teacher_check/  (F11 冒烟2输出)
# - runs/f11_smoke_kd/         (F11 冒烟3输出)
# - runs/f11_*                 (F11 其他中间产物)
# - runs/experiments_zviolin/  (ES-MoE 训练日志)
# - runs/v084/、v08_moa2/、v08_mot6/、v08_moe_mot_shared/  (#54 训练日志)
# - runs/smoke/         (基线 smoke)
# - runs/val*/          (验证结果)
# - runs/predict*/      (推理结果)
# - runs/train*/        (训练输出)
# - runs/*.cache        (YOLO 缓存文件)
# ============================================
runs/

# ============================================
# 关键:experiments_zviolin/ 目录全部排除
# 包含 6 个 .pt 权重 + 大量训练日志
# ============================================
experiments_zviolin/

# ============================================
# 关键:examples/ 目录(YOLO 官方示例代码,不需要上传到 fork)
# ============================================
examples/

# ============================================
# 关键:任何 *zviolin* / *Zviolin* / *zvioling* 目录(避免误传)
# ============================================
*zviolin*/
*Zviolin*/
*zvioling/